<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.article-card') as NodeListOf<HTMLElement>;
    const loadMoreBtn = document.getElementById('load-more-btn');
    const loadLessBtn = document.getElementById('load-less-btn');
    
    const BATCH_SIZE = 8;
    let visibleCount = 4;
    
    // STRICT BROWSER STORAGE HANDLING
    try {
      const storedCount = sessionStorage.getItem('evKellyBlogVisible');
      if (storedCount) {
        visibleCount = parseInt(storedCount, 10);
      }
    } catch (e) {
      console.warn("Storage access restricted. State will not persist across sessions.");
    }

    if (isNaN(visibleCount) || visibleCount < 4) visibleCount = 4;
    if (visibleCount > cards.length) visibleCount = cards.length;

    function renderGrid(isLoadMore = false) {
      let firstNewlyRevealed: HTMLElement | null = null;
      const targetVisibleCount = visibleCount;

      cards.forEach((card, index) => {
        if (index < targetVisibleCount) {
          if (card.classList.contains('hidden')) {
            card.classList.remove('hidden');
            card.classList.add('flex');
            
            if (!firstNewlyRevealed) firstNewlyRevealed = card;
            
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                card.classList.remove('opacity-0', 'translate-y-8', 'scale-95');
                card.classList.add('opacity-100', 'translate-y-0', 'scale-100');
              });
            });
          }
        } else {
          if (!card.classList.contains('hidden')) {
            card.classList.remove('opacity-100', 'translate-y-0', 'scale-100');
            card.classList.add('opacity-0', 'translate-y-8', 'scale-95');
            
            window.setTimeout(() => {
              if (index >= targetVisibleCount) {
                card.classList.add('hidden');
                card.classList.remove('flex');
              }
            }, 500);
          }
        }
      });

      if (loadMoreBtn) {
        loadMoreBtn.style.display = targetVisibleCount >= cards.length ? 'none' : 'inline-flex';
      }
      
      if (loadLessBtn) {
        loadLessBtn.style.display = targetVisibleCount > 4 ? 'inline-flex' : 'none';
      }

      if (isLoadMore && firstNewlyRevealed) {
        const targetElement = firstNewlyRevealed as HTMLElement;
        window.setTimeout(() => {
          targetElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 100);
      } else if (!isLoadMore && loadLessBtn) {
        const gridTop = document.getElementById('blog-grid');
        if (gridTop) gridTop.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      // STRICT BROWSER STORAGE HANDLING
      try {
        sessionStorage.setItem('evKellyBlogVisible', targetVisibleCount.toString());
      } catch (e) {
        // Silently fail if storage is restricted
      }
    }

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        visibleCount = Math.min(visibleCount + BATCH_SIZE, cards.length);
        renderGrid(true);
      });
    }

    if (loadLessBtn) {
      loadLessBtn.addEventListener('click', () => {
        visibleCount = Math.max(visibleCount - BATCH_SIZE, 4);
        renderGrid(false);
      });
    }

    renderGrid(false);
  });
</script>