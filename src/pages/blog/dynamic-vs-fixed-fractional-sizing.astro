  "@type": "Article",
  "headline": "Dynamic vs. Fixed Fractional Sizing",
  "description": "Why risking a static 1% per trade is mathematically suboptimal, and how to implement dynamic fractional Kelly sizing in your algorithms.",
  "author": {
    "@type": "Person",
    "name": "EV Kelly Engine"
  },
  "publisher": {
    "@type": "Organization",
    "name": "EV Kelly Calculator",
    "logo": {
      "@type": "ImageObject",
      "url": "https://evkellycalc.com/favicon.svg"
    }
  },
  "datePublished": "2026-07-08",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://evkellycalc.com/blog/dynamic-vs-fixed-fractional-sizing"
  },
  "wordCount": "1041"
}
</script>