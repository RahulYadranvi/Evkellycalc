  "@type": "Article",
  "headline": "The Psychology of Drawdowns: Sticking to the Math",
  "description": "Why emotional intervention during a mathematical losing streak is the primary cause of algorithmic trading failures.",
  "author": {
    "@type": "Person",
    "name": "EV Kelly Engine"
  },
  "publisher": {
    "@type": "Organization",
    "name": "EV Kelly Calculator",
    "logo": {
      "@type": "ImageObject",
      "url": "https://evkellycalc.com/favicon.svg"
    }
  },
  "datePublished": "2026-06-28",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://evkellycalc.com/blog/psychology-of-drawdowns"
  },
  "wordCount": "1041"
}
</script>