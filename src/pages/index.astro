        </div>
      </div>

    </div>
  </main>
</Layout>

<script>
  import Chart from 'chart.js/auto';

  let growthChart: Chart | null = null;
  let dom: Record<string, HTMLElement | HTMLInputElement> = {};
  
  function initDOM() {
    const ids = [
      'winProb', 'rewardRisk', 'capital', 'stopLoss', 'evOutput',
      'fullKellyOutput', 'fullKellyAmt', 'halfKellyOutput', 'halfKellyAmt',
      'quarterKellyOutput', 'quarterKellyAmt', 'rorOutput', 'rorDesc', 'calcBtn', 'growthChart',
      'finalFull', 'finalHalf', 'finalQuarter', 'winProbError'
    ];
    
    ids.forEach(id => {
      const el = document.getElementById(id);
      if (el) dom[id] = el;
    });

    Chart.defaults.font.family = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif';
  }

  function formatCurrency(value: number, compact: boolean = false): string {
    if (value === 0) return "$0";
    if (value < 0) return "-" + formatCurrency(-value, compact);
    
    if (value >= 1e15) {
      return "$" + value.toExponential(2);
    }

    if (!compact || value < 1000000) {
      return new Intl.NumberFormat('en-US', { 
        style: 'currency', 
        currency: 'USD',
        maximumFractionDigits: 0
      }).format(value);
    }
    
    const suffixes = ["", "K", "M", "B", "T"];
    let magnitude = Math.floor(Math.log10(value) / 3);
    
    if (magnitude >= suffixes.length) {
      magnitude = suffixes.length - 1; 
    }
    
    const scaled = value / Math.pow(10, magnitude * 3);
    
    const formatted = new Intl.NumberFormat('en-US', {
      maximumFractionDigits: 2
    }).format(scaled);
    
    return "$" + formatted + suffixes[magnitude];
  }

  function calculate() {
    const winInput = dom.winProb as HTMLInputElement;
    const rewardInput = dom.rewardRisk as HTMLInputElement;
    const capInput = dom.capital as HTMLInputElement;
    const stopInput = dom.stopLoss as HTMLInputElement;

    // 1. INSTANT VALIDATION (Triggered on keystroke, regardless of empty fields)
    let winErrorActive = false;
    if (winInput.value !== '') {
      let rawWin = parseFloat(winInput.value);
      if (rawWin > 100) {
        winInput.value = ''; // Instantly clear the field
        if (dom.winProbError) dom.winProbError.classList.remove('hidden'); // Throw error
        winErrorActive = true;
      } else if (rawWin < 0) {
        winInput.value = '';
        if (dom.winProbError) dom.winProbError.classList.add('hidden');
      } else {
        if (dom.winProbError) dom.winProbError.classList.add('hidden');
      }
    }

    // Hide error automatically if user manually backspaces to empty
    if (winInput.value === '' && !winErrorActive) {
      if (dom.winProbError) dom.winProbError.classList.add('hidden');
    }

    // Silently fix stop loss bounds
    if (stopInput.value !== '') {
      let rawStop = parseFloat(stopInput.value);
      if (rawStop > 99 || rawStop < 1) {
        stopInput.value = '';
      }
    }

    // 2. ZERO STATE RE-RENDER
    if (winInput.value === '' || rewardInput.value === '' || capInput.value === '' || stopInput.value === '') {
        if (dom.evOutput) {
          dom.evOutput.style.color = 'inherit';
          dom.evOutput.textContent = '0.00%';
        }
        
        if (dom.fullKellyOutput) dom.fullKellyOutput.textContent = '0.00%';
        if (dom.fullKellyAmt) dom.fullKellyAmt.textContent = '$0';
        
        if (dom.halfKellyOutput) dom.halfKellyOutput.textContent = '0.00%';
        if (dom.halfKellyAmt) dom.halfKellyAmt.textContent = '$0';
        
        if (dom.quarterKellyOutput) dom.quarterKellyOutput.textContent = '0.00%';
        if (dom.quarterKellyAmt) dom.quarterKellyAmt.textContent = '$0';
        
        if (dom.rorOutput) dom.rorOutput.textContent = '0.00%';
        if (dom.rorDesc) dom.rorDesc.innerHTML = `Probability of hitting stop loss using Half Kelly.`;
        
        updateChart(0, 0, 0, 0, 0, 0); 
        return; 
    }

    // 3. MATH ENGINE EXECUTION
    let rawWinProb = parseFloat(winInput.value) || 0;
    let rawRewardRisk = parseFloat(rewardInput.value) || 0;
    let rawCapital = parseFloat(capInput.value) || 0;
    let rawStopLoss = parseFloat(stopInput.value) || 0;

    const p = rawWinProb / 100;
    const b = Math.max(0.01, Math.min(10000, rawRewardRisk));
    const capital = Math.max(1, Math.min(1000000000, rawCapital)); 
    const stopLoss = rawStopLoss / 100;
    const q = 1 - p;
    
    const ev = (p * b) - q;
    const evPercentage = ev * 100;

    let fullKelly = b > 0 ? ((p * b) - q) / b : 0;
    fullKelly = Math.max(0, fullKelly); 

    const halfKelly = fullKelly / 2;
    const quarterKelly = fullKelly / 4;

    let ror = 1.0; 
    if (fullKelly > 0 && ev > 0) {
      const threshold = 1 - stopLoss;
      const f = 0.5; 
      ror = Math.pow(threshold, (2 / f) - 1);
      ror = Math.min(1, Math.max(0, ror)); 
    }

    if (dom.evOutput) {
      const sign = evPercentage > 0 ? '+' : '';
      const rootStyles = getComputedStyle(document.documentElement);
      const colorGreen = rootStyles.getPropertyValue('--theme-accent-green').trim() || '#30D158';
      const colorRed = rootStyles.getPropertyValue('--theme-accent-red').trim() || '#FF453A';
      
      dom.evOutput.style.color = evPercentage > 0 ? colorGreen : (evPercentage < 0 ? colorRed : 'inherit');
      
      const evFormatted = evPercentage % 1 === 0 ? evPercentage.toFixed(0) : evPercentage.toFixed(2);
      dom.evOutput.textContent = `${sign}${evFormatted}%`;
    }

    dom.fullKellyOutput.textContent = `${(fullKelly * 100).toFixed(2)}%`;
    dom.fullKellyAmt.textContent = formatCurrency(fullKelly * capital);
    
    dom.halfKellyOutput.textContent = `${(halfKelly * 100).toFixed(2)}%`;
    dom.halfKellyAmt.textContent = formatCurrency(halfKelly * capital);
    
    dom.quarterKellyOutput.textContent = `${(quarterKelly * 100).toFixed(2)}%`;
    dom.quarterKellyAmt.textContent = formatCurrency(quarterKelly * capital);

    dom.rorOutput.textContent = `${(ror * 100).toFixed(2)}%`;
    
    if (dom.rorDesc) {
      dom.rorDesc.innerHTML = `At Half Kelly, the mathematical probability of hitting a <strong>${(stopLoss * 100).toFixed(0)}% drawdown</strong>.`;
    }

    updateChart(capital, fullKelly, halfKelly, quarterKelly, p, b);
  }

  function updateChart(startBankroll: number, fFull: number, fHalf: number, fQuarter: number, p: number, b: number) {
    const events = 100;
    const labels = Array.from({length: events + 1}, (_, i) => i);
    
    const calcGrowth = (f: number) => {
      if (f <= 0 || startBankroll === 0) return Array(events + 1).fill(startBankroll);
      const growthFactor = Math.pow(1 + f * b, p) * Math.pow(1 - f, 1 - p);
      const data = [startBankroll];
      let current = startBankroll;
      for (let i = 1; i <= events; i++) {
        current *= growthFactor;
        data.push(current);
      }
      return data;
    };

    const dataFull = calcGrowth(fFull);
    const dataHalf = calcGrowth(fHalf);
    const dataQuarter = calcGrowth(fQuarter);

    dom.finalFull.textContent = formatCurrency(dataFull[events], true);
    dom.finalHalf.textContent = formatCurrency(dataHalf[events], true);
    dom.finalQuarter.textContent = formatCurrency(dataQuarter[events], true);

    const ctx = dom.growthChart as HTMLCanvasElement;
    if (!ctx) return;
    
    if (growthChart) {
      growthChart.destroy(); 
    }

    const chartCtx = ctx.getContext('2d');
    if (!chartCtx) return;
    
    const rootStyles = getComputedStyle(document.documentElement);
    const colorBlue = rootStyles.getPropertyValue('--theme-accent-blue').trim() || '#0A84FF';
    const colorGreen = rootStyles.getPropertyValue('--theme-accent-green').trim() || '#30D158';
    const colorGray = rootStyles.getPropertyValue('--theme-text-muted').trim() || '#8E8E93';
    
    const createGradient = (hexColor: string) => {
      if(!hexColor.startsWith('#')) return 'transparent';
      
      let r = 0, g = 0, b = 0;
      if (hexColor.length === 7) {
        r = parseInt(hexColor.slice(1, 3), 16);
        g = parseInt(hexColor.slice(3, 5), 16);
        b = parseInt(hexColor.slice(5, 7), 16);
      }
      
      const gradient = chartCtx.createLinearGradient(0, 0, 0, 360);
      gradient.addColorStop(0, `rgba(${r}, ${g}, ${b}, 0.25)`);
      gradient.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`);
      return gradient;
    };
    
    const isMobile = window.innerWidth < 640;

    growthChart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'Full Kelly',
            data: dataFull,
            borderColor: colorBlue,
            backgroundColor: createGradient(colorBlue),
            borderWidth: isMobile ? 2 : 3,
            pointRadius: 0,
            pointHoverRadius: isMobile ? 4 : 6,
            pointHoverBackgroundColor: colorBlue,
            pointHoverBorderColor: '#fff',
            pointHoverBorderWidth: 2,
            tension: 0.4,
            fill: true
          },
          {
            label: 'Half Kelly',
            data: dataHalf,
            borderColor: colorGreen,
            backgroundColor: createGradient(colorGreen),
            borderWidth: isMobile ? 2 : 3,
            pointRadius: 0,
            pointHoverRadius: isMobile ? 4 : 6,
            pointHoverBackgroundColor: colorGreen,
            pointHoverBorderColor: '#fff',
            pointHoverBorderWidth: 2,
            tension: 0.4,
            fill: true
          },
          {
            label: 'Quarter Kelly',
            data: dataQuarter,
            borderColor: colorGray,
            backgroundColor: createGradient(colorGray),
            borderWidth: isMobile ? 2 : 3,
            pointRadius: 0,
            pointHoverRadius: isMobile ? 4 : 6,
            pointHoverBackgroundColor: colorGray,
            pointHoverBorderColor: '#fff',
            pointHoverBorderWidth: 2,
            tension: 0.4,
            fill: true
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { intersect: false, mode: 'index' },
        plugins: {
          legend: { display: false },
          tooltip: { 
            backgroundColor: 'rgba(28, 28, 30, 0.9)', 
            titleColor: '#8E8E93', 
            bodyColor: '#ffffff',
            bodyFont: { size: isMobile ? 12 : 14, weight: 'bold' },
            borderColor: 'rgba(150, 150, 150, 0.2)', 
            borderWidth: 1, 
            padding: isMobile ? 10 : 16,
            cornerRadius: 12,
            displayColors: true,
            boxPadding: 4,
            callbacks: {
              title: (context) => `Event ${context[0].label}`,
              label: (context) => ` ${context.dataset.label}: ${formatCurrency(context.parsed.y as number, true)}`
            }
          }
        },
        scales: {
          x: { 
            grid: { display: false }, 
            border: { display: false },
            ticks: { 
              color: '#8E8E93', 
              font: { size: isMobile ? 10 : 12, weight: 500 },
              maxTicksLimit: isMobile ? 4 : 5 
            } 
          },
          y: { 
            grid: { 
              color: 'rgba(255, 255, 255, 0.05)',
              drawTicks: false,
            }, 
            border: { display: false },
            ticks: { 
              color: '#8E8E93', 
              font: { size: isMobile ? 10 : 12, weight: 500 },
              padding: isMobile ? 5 : 10,
              callback: (value) => formatCurrency(value as number, true)
            } 
          }
        }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initDOM();
    
    document.querySelectorAll('.faq-button').forEach(button => {
      button.addEventListener('click', () => {
        const faqItem = button.closest('.faq-item');
        if(!faqItem) return;
        const isActive = faqItem.classList.contains('active');

        document.querySelectorAll('.faq-item').forEach(item => {
          item.classList.remove('active');
          const answer = item.querySelector('.faq-answer') as HTMLElement;
          const icon = item.querySelector('.faq-vertical-line') as HTMLElement;
          if(answer) answer.style.gridTemplateRows = '0fr';
          if(icon) icon.style.transform = 'rotate(90deg)';
        });

        if (!isActive) {
          faqItem.classList.add('active');
          const answer = faqItem.querySelector('.faq-answer') as HTMLElement;
          const icon = faqItem.querySelector('.faq-vertical-line') as HTMLElement;
          if(answer) answer.style.gridTemplateRows = '1fr';
          if(icon) icon.style.transform = 'rotate(0deg)';
        }
      });
    });
    
    let inputDebounceTimer: any;
    const debouncedCalculate = () => {
      clearTimeout(inputDebounceTimer);
      inputDebounceTimer = setTimeout(() => { 
        calculate(); 
      }, 50);
    };

    const inputs = ['winProb', 'rewardRisk', 'capital', 'stopLoss'];
    inputs.forEach(id => {
      if(dom[id]) dom[id].addEventListener('input', debouncedCalculate);
    });

    if (dom.calcBtn) {
      dom.calcBtn.addEventListener('click', () => {
        calculate(); 
        
        if (window.innerWidth < 1280) {
          const variancePanel = dom.calcBtn.parentElement?.nextElementSibling as HTMLElement;
          
          if (variancePanel) {
            const headerElement = document.querySelector('header');
            const headerOffset = headerElement ? headerElement.offsetHeight + 16 : 110;
            
            const elementPosition = variancePanel.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.scrollY - headerOffset;
            
            window.scrollTo({
                 top: offsetPosition,
                 behavior: "smooth"
            });
          }
        }
      });
    }
    
    let resizeTimer: any;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        calculate();
      }, 250);
    });

    requestAnimationFrame(() => {
      calculate();
    });
  });
</script>

