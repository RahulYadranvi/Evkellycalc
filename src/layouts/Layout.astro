---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "EV Kelly Calculator | Optimal Position Sizing", 
  description = "A premium quantitative finance calculator designed for mathematical edge tracking and fractional Kelly capital allocation." 
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        
        <script data-cookieconsent="ignore" is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('consent', 'default', {
            'ad_personalization': 'denied',
            'ad_storage': 'denied',
            'ad_user_data': 'denied',
            'analytics_storage': 'denied',
            'functionality_storage': 'denied',
            'personalization_storage': 'denied',
            'security_storage': 'granted'
          });
        </script>

        <script id="Cookiebot" src="https://consent.cookiebot.com/uc.js" data-cbid="3bce0ba5-2e8c-44e6-8449-fb7c22893265" data-blockingmode="auto" type="text/javascript" is:inline></script>
        
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
        
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
        <meta name="twitter:card" content="summary_large_image" />
        
        <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <meta name="apple-mobile-web-app-title" content="EV Kelly" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="generator" content={Astro.generator} />
        
        <script type="text/plain" data-cookieconsent="statistics" src="https://www.googletagmanager.com/gtag/js?id=G-YB006FWDWW" is:inline></script>
        <script type="text/plain" data-cookieconsent="statistics" is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());

          gtag('config', 'G-YB006FWDWW');
        </script>
    </head>
    <body class="antialiased selection:bg-[#0A84FF]/30 selection:text-white min-h-screen flex flex-col relative overflow-x-hidden bg-black text-white">
        <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 bg-white text-black px-4 py-2 font-bold rounded">Skip to content</a>
        
        <style is:global>
          :root {
            --theme-bg-main: #000000;
            --theme-text-main: #FFFFFF;
            --theme-text-muted: #D1D5DB;
            --theme-text-inverse: #000000;
            --theme-accent-blue: #0A84FF;
            --theme-accent-green: #30D158;
            --theme-accent-red: #FF453A;
            --theme-primary-btn: #F9F6EE; 
            --theme-primary-btn-hover: #FFFFFF;
            --theme-font-base: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            --theme-radius-panel: 32px;
            --theme-radius-input: 16px;
            --liquid-bg: rgba(28, 28, 30, 0.45); 
            --liquid-blur: blur(24px); 
            --liquid-saturation: saturate(150%);
            --liquid-border: rgba(255, 255, 255, 0.08);
            --liquid-highlight: inset 0 1px 1px rgba(255, 255, 255, 0.15);
            --liquid-shadow: 0 24px 48px rgba(0, 0, 0, 0.4);
            --liquid-input-bg: rgba(255, 255, 255, 0.05);
            --liquid-input-border: rgba(255, 255, 255, 0.08);
          }
          
          input[type="number"]::-webkit-inner-spin-button,
          input[type="number"]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
          }
          input[type="number"] {
            -moz-appearance: textfield;
            appearance: textfield;
          }

          body {
            font-family: var(--theme-font-base);
            background-color: var(--theme-bg-main);
            color: var(--theme-text-main);
          }

          .liquid-panel {
            position: relative; 
            background-color: var(--liquid-bg);
            backdrop-filter: var(--liquid-blur) var(--liquid-saturation);
            -webkit-backdrop-filter: var(--liquid-blur) var(--liquid-saturation);
            border: 1px solid var(--liquid-border);
            border-radius: var(--theme-radius-panel);
            background-image: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0) 100%);
            transform: translateZ(0); 
            transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.6s ease;
          }

          .liquid-panel::before {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: inherit;
            pointer-events: none; 
            background: radial-gradient(
              800px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
              rgba(255, 255, 255, 0.06),
              transparent 40%
            );
            opacity: 0;
            transition: opacity 0.4s ease;
            z-index: 0;
          }

          .liquid-panel:hover::before { opacity: 1; }
          .liquid-panel > * { position: relative; z-index: 1; }
          .liquid-panel:not(.static-panel):hover { transform: translateY(-4px) scale(1.005) translateZ(0); }
          .liquid-panel.static-panel:hover { transform: translateZ(0); box-shadow: var(--liquid-highlight), var(--liquid-shadow); }

          .liquid-input {
            background-color: var(--liquid-input-bg);
            border: 1px solid var(--liquid-input-border);
            color: var(--theme-text-main);
            border-radius: var(--theme-radius-input);
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
          }
          .liquid-input:focus {
            outline: none;
            border-color: var(--theme-accent-blue);
            background-color: var(--theme-bg-main);
            box-shadow: 0 0 0 3px rgba(10, 132, 255, 0.25);
          }

          .liquid-btn {
            position: relative;
            overflow: hidden; 
            background-color: var(--theme-primary-btn);
            color: var(--theme-text-inverse);
            border-radius: var(--theme-radius-input);
            transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
          }

          .liquid-btn::after {
            content: '';
            position: absolute;
            top: 0;
            left: -150%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(245, 41, 41, 0.8), transparent);
            transform: skewX(-20deg);
            transition: none; 
          }

          @keyframes button-shine {
            0% { left: -150%; }
            100% { left: 150%; }
          }

          .liquid-btn.trigger-shine::after {
            animation: button-shine 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
          }

          .liquid-btn:hover { 
            background-color: var(--theme-primary-btn-hover); 
            transform: translateY(-3px) scale(1.02); 
            box-shadow: 0 12px 24px rgba(249, 246, 238, 0.15);
          }

          .liquid-btn:active { 
            transform: scale(0.96) translateY(0); 
            box-shadow: 0 4px 8px rgba(249, 246, 238, 0.1);
          }

          .animate-reveal {
            opacity: 0; 
            -webkit-animation: hero-lift 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
            animation: hero-lift 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
          }

          .delay-100 { 
            -webkit-animation-delay: 0.15s;
            animation-delay: 0.15s; 
          }
          .delay-200 { 
            -webkit-animation-delay: 0.3s;
            animation-delay: 0.3s; 
          }

          @-webkit-keyframes hero-lift {
            0% { opacity: 0; transform: translateY(24px); }
            100% { opacity: 1; transform: translateY(0); }
          }
          
          @keyframes hero-lift {
            0% { opacity: 0; transform: translateY(24px); }
            100% { opacity: 1; transform: translateY(0); }
          }

          @media (prefers-reduced-motion: reduce) {
            .animate-reveal {
              -webkit-animation: none !important;
              animation: none !important;
              transform: none !important;
              opacity: 1 !important;
            }
          }
        </style>

        <div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
          <div class="absolute top-[-10%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-indigo-900/15 blur-[120px] mix-blend-screen animate-blob"></div>
          <div class="absolute bottom-[-10%] right-[-10%] w-[40vw] h-[40vw] rounded-full bg-violet-900/15 blur-[120px] mix-blend-screen animate-blob animation-delay-2000"></div>
          <div class="absolute top-[20%] left-[30%] w-[40vw] h-[40vw] rounded-full bg-blue-900/10 blur-[100px] mix-blend-screen animate-blob animation-delay-4000"></div>
        </div>

        <header class="sticky top-0 z-40 w-full bg-black/80 backdrop-blur-md border-b border-white/[0.05]">
            <div class="max-w-[1400px] mx-auto px-4 sm:px-8 md:px-16 lg:px-24 h-24 flex items-center justify-between">
                
                <a href="/" class="flex items-center gap-4 hover:opacity-80 hover:scale-105 transition-all duration-300 z-50">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center">
                        <img src="/favicon.svg" alt="EV Kelly Logo" class="w-8 h-8 object-contain" />
                    </div>
                    <span class="text-xl sm:text-2xl font-bold tracking-tight text-white">EV Kelly Calculator</span>
                </a>

            <div class="hidden md:flex items-center">
                <nav class="flex items-center gap-6 lg:gap-8 text-sm lg:text-base font-medium text-[#8E8E93] px-6 lg:px-8 py-3 rounded-full border border-white/[0.05] bg-[rgba(28,28,30,0.45)] shadow-sm">
                    <a href="/" class="inline-block hover:text-white hover:-translate-y-0.5 hover:scale-110 transition-all duration-300 ease-out">Calculator</a>
                    <a href="/how-it-works" class="inline-block hover:text-white hover:-translate-y-0.5 hover:scale-110 transition-all duration-300 ease-out">How it Works</a>
                    <a href="/blog" class="inline-block hover:text-white hover:-translate-y-0.5 hover:scale-110 transition-all duration-300 ease-out">Blog</a>
                    <a href="/about" class="inline-block hover:text-white hover:-translate-y-0.5 hover:scale-110 transition-all duration-300 ease-out">About</a>
                    <a href="/contact" class="inline-block hover:text-white hover:-translate-y-0.5 hover:scale-110 transition-all duration-300 ease-out">Contact</a>
                    <a href="/privacy" class="inline-block hover:text-white hover:-translate-y-0.5 hover:scale-110 transition-all duration-300 ease-out">Privacy</a>
                    <a href="/terms" class="inline-block hover:text-white hover:-translate-y-0.5 hover:scale-110 transition-all duration-300 ease-out">Terms</a>
                    <a href="/disclaimer" class="inline-block hover:text-white hover:-translate-y-0.5 hover:scale-110 transition-all duration-300 ease-out">Disclaimer</a>
                </nav>
            </div>

                <button id="mobile-menu-btn" aria-label="Toggle Navigation Menu" class="md:hidden p-2 z-50 text-[#8E8E93] hover:text-white hover:scale-110 active:scale-95 transition-all duration-300">
                    <svg id="icon-menu" class="w-7 h-7 block" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                    <svg id="icon-close" class="w-7 h-7 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        </header>

        <main class="relative z-10 flex-1 flex flex-col">
            <slot />
        </main>

        <div id="mobile-menu-overlay" class="fixed inset-0 top-0 pt-24 bg-black/95 backdrop-blur-3xl z-30 hidden flex-col items-center justify-start" role="dialog" aria-modal="true">
            <nav class="flex flex-col items-center w-full px-6 gap-8 mt-10">
              <a href="/" class="hover:text-white transition-colors py-4">Calculator</a>
              <a href="/how-it-works" class="hover:text-white transition-colors py-4">How it Works</a>
              <a href="/blog" class="hover:text-white transition-colors py-4">Blog</a>
              <a href="/about" class="hover:text-white transition-colors py-4">About</a>
              <a href="/contact" class="hover:text-white transition-colors py-4">Contact</a>
              <a href="/privacy" class="hover:text-white transition-colors py-4">Privacy Policy</a>
              <a href="/terms" class="hover:text-white transition-colors py-4">Terms of Service</a>
              <a href="/disclaimer" class="hover:text-white transition-colors py-4">Disclaimer</a>
            </nav>
        </div>

        <footer class="relative z-10 border-t border-white/[0.05] bg-black/80 backdrop-blur-md mt-auto">
            <div class="max-w-[1400px] mx-auto px-4 sm:px-8 md:px-16 lg:px-24 py-8 sm:py-10">
                
                <div class="flex flex-col md:flex-row items-center justify-between gap-6 md:gap-4 text-center md:text-left mb-6 sm:mb-8">
                    <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">&copy; {new Date().getFullYear()} EV Kelly Calculator. All rights reserved.</p>
                    <div class="flex flex-wrap gap-4 sm:gap-6 justify-center w-full md:w-auto font-medium text-xs sm:text-sm text-gray-400">
                        <a href="/" class="hover:text-white transition-colors">Calculator</a>
                        <a href="/how-it-works" class="hover:text-white transition-colors">How it Works</a>
                        <a href="/blog" class="hover:text-white transition-colors">Blog</a>
                        <a href="/about" class="hover:text-white transition-colors">About Us</a>
                        <a href="/contact" class="hover:text-white transition-colors">Contact</a>
                        <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
                        <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
                        <a href="/disclaimer" class="hover:text-white transition-colors">Disclaimer</a>
                    </div>
                </div>

                <div class="border-t border-white/[0.05] pt-6 sm:pt-8 text-center md:text-left">
                    <p class="text-[10px] sm:text-xs text-gray-400 leading-relaxed max-w-6xl">
                        <strong class="text-gray-300">Disclaimer:</strong> The EV Kelly Calculator is a quantitative mathematical tool provided for educational and informational purposes only. It does not constitute financial, investment, or trading advice. Trading in financial markets involves a high degree of risk and may result in the total loss of your capital. Real-world stochastic variance and execution friction (slippage, commissions) will deviate from theoretical geometric projections. Always conduct your own due diligence before allocating live capital.
                    </p>
                </div>

            </div>
        </footer>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const menuBtn = document.getElementById('mobile-menu-btn');
                const overlay = document.getElementById('mobile-menu-overlay');
                const iconMenu = document.getElementById('icon-menu');
                const iconClose = document.getElementById('icon-close');

                if (menuBtn && overlay && iconMenu && iconClose) {
                    // Set initial ARIA state
                    menuBtn.setAttribute('aria-expanded', 'false');
                    
                    menuBtn.addEventListener('click', () => {
                        // Toggle ARIA state for screen readers
                        const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
                        menuBtn.setAttribute('aria-expanded', String(!isExpanded));
                        
                        overlay.classList.toggle('hidden');
                        overlay.classList.toggle('flex');
                        iconMenu.classList.toggle('hidden');
                        iconClose.classList.toggle('hidden');
                        document.body.style.overflow = overlay.classList.contains('flex') ? 'hidden' : '';
                    });
                }

                document.querySelectorAll('.liquid-btn').forEach(btn => {
                    const playShine = () => {
                        btn.classList.remove('trigger-shine');
                        void btn.getBoundingClientRect(); 
                        btn.classList.add('trigger-shine');
                    };

                    btn.addEventListener('mouseenter', playShine);
                    btn.addEventListener('mousedown', playShine);
                    btn.addEventListener('touchstart', playShine, {passive: true});
                });

                // RENDER FIX - OPTIMIZED WITH requestAnimationFrame
                let mouseX = 0;
                let mouseY = 0;
                let ticking = false;

                function updatePanels() {
                    document.querySelectorAll('.liquid-panel').forEach((panel) => {
                        const htmlPanel = panel as HTMLElement;
                        const rect = htmlPanel.getBoundingClientRect();
                        htmlPanel.style.setProperty('--mouse-x', `${mouseX - rect.left}px`);
                        htmlPanel.style.setProperty('--mouse-y', `${mouseY - rect.top}px`);
                    });
                }

                document.addEventListener('mousemove', (e) => {
                    mouseX = e.clientX;
                    mouseY = e.clientY;
                    if (!ticking) {
                        window.requestAnimationFrame(() => {
                            updatePanels();
                            ticking = false;
                        });
                        ticking = true;
                    }
                });

                document.addEventListener('scroll', () => {
                    if (!ticking) {
                        window.requestAnimationFrame(() => {
                            updatePanels();
                            ticking = false;
                        });
                        ticking = true;
                    }
                }, { passive: true });
            });
        </script>
    </body>
</html>